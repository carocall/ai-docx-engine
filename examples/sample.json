{
  "blocks": [
    {
      "type": "text",
      "style": "标题1",
      "runs": [
        {"text": "1 项目概述"}
      ]
    },
    {
      "type": "text",
      "style": "正文",
      "runs": [
        {"text": "这是使用新结构书写的正文段落。JSON格式更加清晰，样式由 style 字段指定，文字内容放在 runs 数组中。"}
      ]
    },
    {
      "type": "image",
      "style": "图片",
      "src": "images/样例.png"
    },
    {
      "type": "text",
      "style": "图注",
      "runs": [
        {"text": "图1-1 示例图片"}
      ]
    },
    {
      "type": "text",
      "style": "标题2",
      "runs": [
        {"text": "1.1 表格示例"}
      ]
    },
    {
      "type": "text",
      "style": "正文",
      "runs": [
        {"text": "表格的样式配置（表头样式、表内样式、边框类型）现在都放在内容JSON中，而不是style.json里。这样每个表格可以独立配置。"}
      ]
    },
    {
      "type": "table",
      "style": "表格",
      "rows": 4,
      "cols": 3,
      "cells": [
        ["功能名称", "支持情况", "说明"],
        ["段落转换", "是", "使用 text 类型和命名样式"],
        ["图片插入", "是", "使用 image 类型和图片样式"],
        ["表格生成", "是", "使用 table 类型，样式在内容中配置"]
      ],
      "header_style": "表头",
      "body_style": "表内文字",
      "border": "three_line",
      "space_after": {"units": "pt", "value": 12}
    },
    {
      "type": "text",
      "style": "表注",
      "runs": [
        {"text": "表1-1 功能支持列表"}
      ]
    },
    {
      "type": "page-break"
    },
    {
      "type": "text",
      "style": "标题1",
      "runs": [
        {"text": "2 第二章"}
      ]
    },
    {
      "type": "text",
      "style": "正文",
      "runs": [
        {"text": "这里演示 page-break 类型生成换页符。"}
      ]
    },
    {
      "type": "text",
      "style": "正文",
      "runs": [
        {"text": "下面展示 "},
        {"text": "粗体", "bold": true},
        {"text": "、"},
        {"text": "斜体", "italic": true},
        {"text": "、"},
        {"text": "下划线", "underline": true},
        {"text": " 等内联样式。"}
      ]
    },
    {
      "type": "text",
      "style": "正文",
      "runs": [
        {"text": "还可以使用 "},
        {"text": "上标", "superscript": true},
        {"text": " 和 "},
        {"text": "下标", "subscript": true},
        {"text": "，以及 "},
        {"text": "红色文字", "color": "FF0000"},
        {"text": " 和 "},
        {"text": "高亮背景", "highlight": "FFFF00"},
        {"text": "。"}
      ]
    },
    {
      "type": "text",
      "style": "一个不存在的样式",
      "runs": [
        {"text": "text的样式不存在就会用默认的text样式"}
      ]
    },
    {
      "type": "table",
      "style": "一个不存在的样式",
      "rows": 3,
      "cols": 2,
      "cells": [
        ["表头1", "表头2"],
        ["数据1", "数据2"],
        ["数据3", "数据4"]
      ],
      "header_style": "表头",
      "body_style": "表内文字",
      "border": "grid",
      "space_after": {"units": "pt", "value": 12}
    },
    {
      "type": "image",
      "style": "一个不存在的样式",
      "src": "images/样例.png"
    }
  ]
